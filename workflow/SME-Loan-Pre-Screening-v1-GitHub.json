    {
      "parameters": {
        "jsCode": "\nconst assessment = $('Generate AI Loan Assessment').first().json.choices[0].message.content;\n\nfunction escapeHtml(text) {\n  return text\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nfunction markdownToHtml(text) {\n  let html = escapeHtml(text);\n\n  // Convert Markdown bold text\n  html = html.replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>');\n\n  html = html.replace(/(?<!\\*)\\*([^*\\n]+)\\*(?!\\*)/g, '<em>$1</em>');\n\n  // Convert headings\n  html = html.replace(\n    /^(#{1,3})\\s*(.+)$/gm,\n    (_, hashes, heading) => `<h${hashes.length}>${heading}</h${hashes.length}>`\n  );\n\n  // Convert bullet points\n  html = html.replace(/^\\s*-\\s+(.+)$/gm, '<li>$1</li>');\n  html = html.replace(/(?:<li>.*<\\/li>\\s*)+/gs, match => `<ul>${match}</ul>`);\n\n  // Convert remaining line breaks\n  html = html.replace(/\\n{2,}/g, '</p><p>');\n  html = html.replace(/\\n/g, '<br>');\n\n  return `<div style=\"font-family:Arial,sans-serif;line-height:1.6\"><p>${html}</p></div>`;\n}\n\nreturn {\n  json: {\n    ...$json,\n    formatted_assessment: markdownToHtml(assessment)\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
