      "name": "Extract Application Data"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  const data = item.json;\n\n\n  const applicationId = `LOAN-${Date.now()}-${Math.floor(Math.random() * 10000)}`;\n\n  const submissionRefernce = data.submission_reference\n  const businessName = data.business_name;\n  const monthlyRevenue = Number(data.monthly_revenue);\n  const requestedLoan = Number(data.requested_loan_amount);\n\n  // Validate the application data\n  const errors = [];\n\n  if (!businessName || typeof businessName !== 'string') {\n    errors.push('Business name is missing.');\n  }\n\n  if (!Number.isFinite(monthlyRevenue) || monthlyRevenue <= 0) {\n    errors.push('Monthly revenue must be greater than zero.');\n  }\n\n  if (!Number.isFinite(requestedLoan) || requestedLoan <= 0) {\n    errors.push('Requested loan amount must be greater than zero.');\n  }\n\n  // Calculate the loan-to-monthly-revenue ratio\n  const loanToRevenueRatio =\n    monthlyRevenue > 0 && requestedLoan > 0\n      ? Number((requestedLoan / monthlyRevenue).toFixed(2))\n      : null;\n\n  // Preliminary screening only—not a credit decision\n  let screeningStatus;\n\n  if (errors.length > 0) {\n    screeningStatus = 'Needs More Information';\n  } else if (loanToRevenueRatio <= 1) {\n    screeningStatus = 'Lower Initial Risk Flag';\n  } else if (loanToRevenueRatio <= 3) {\n    screeningStatus = 'Manual Review Required';\n  } else {\n    screeningStatus = 'Higher Initial Risk Flag';\n  }\n\n  return {\n    json: {\n      application_id: applicationId,\n      submission_reference: submissionRefernce,\n      business_name: businessName,\n      monthly_revenue: monthlyRevenue,\n      requested_loan_amount: requestedLoan,\n      loan_to_monthly_revenue_ratio: loanToRevenueRatio,\n      screening_status: screeningStatus,\n      validation_errors: errors,\n      screening_timestamp: new Date().toISOString()\n    }\n  };\n});\n"
      },
